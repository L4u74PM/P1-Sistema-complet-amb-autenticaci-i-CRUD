<!DOCTYPE html>
<html lang="ca">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login i registre</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/js/register.js" defer></script>
</head>

<body>
    <div class="container">
        <% if (typeof username != 'undefined') { %>
            <div class="form-container">
                <h2>Hola <%= username %>!</h2>
                <p>Ja has iniciat sessió.</p>
                <button id="close-session">Tancar sessió</button>
                <a href="/protected">Anar al meu panell</a>
            </div>
        <% } %>

        <% if (typeof username === 'undefined') { %>
            <div class="form-container">
                <form id="login-form">
                    <h2>Login</h2>
                    <label for="login-username">Usuari:</label>
                    <input type="text" id="login-username" name="username" required>

                    <label for="login-password">Contrasenya:</label>
                    <input type="password" id="login-password" name="password" required>

                    <button type="submit">Entrar</button>
                    <span>&nbsp;</span>
                </form>
            </div>

            <div class="form-container">
                <form id="register-form">
                    <h2>Registre</h2>
                    <label for="register-username">Usuari (3-20 caràcters):</label>
                    <input type="text" id="register-username" name="username" required>

                    <label for="register-password">Contrasenya (mínim 8, amb lletres i números):</label>
                    <input type="password" id="register-password" name="password" required>

                    <label for="register-confirm-password">Repeteix la contrasenya:</label>
                    <input type="password" id="register-confirm-password" name="confirm-password" required>

                    <button type="submit">Registrar-me</button>
                    <span>&nbsp;</span>
                </form>
            </div>
        <% } %>
    </div>
</body>

</html>
